# Нейросеть для ответов: gigachat, openai или none (тогда показывается найденный фрагмент)
LLM_PROVIDER=none

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Имя модели можно не указывать: возьмётся первая доступная по ключу
GIGACHAT_MODEL=

# Любой OpenAI-совместимый API (YandexGPT, OpenAI и т. п.)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
